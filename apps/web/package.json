    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.3",
    "antd": "6.6.6",
    "dayjs": "1.11.23",
    "framer-motion": "14.3.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@bookleaf/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
