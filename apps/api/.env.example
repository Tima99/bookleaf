# ---------------------------------------------------------------------------
# BookLeaf API — copy to apps/api/.env and adjust. Never commit the real file.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB (local default shown; use a MongoDB Atlas URI in production)
MONGODB_URI=mongodb://127.0.0.1:27017/bookleaf

# Session signing secret — at least 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SESSION_TTL_HOURS=8

# Comma-separated list of allowed browser origins (the Next.js app).
CORS_ORIGINS=http://localhost:3000
# Cookie settings. For a cross-site deployment (e.g. Vercel + Render) use
# COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=
# Number of reverse-proxy hops to trust (1 on Render/Railway/Heroku).
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# AI — keys live ONLY here (server-side). Leave the key empty to run in
# manual mode: tickets are still created and triaged with keyword rules,
# and admins write replies from templates.
# ---------------------------------------------------------------------------
AI_PROVIDER=anthropic            # anthropic | openai | none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides (per-strategy settings take precedence).
# AI_TRIAGE_MODEL=claude-haiku-5-5
# AI_DRAFT_MODEL=claude-opus-5-5
AI_TRIAGE_TIMEOUT_MS=20000
AI_DRAFT_TIMEOUT_MS=60000
AI_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# Seed (development/demo only). Passwords are hashed with bcrypt on insert.
# ---------------------------------------------------------------------------
SEED_DATA_PATH=../../data/bookleaf_sample_data.json
SEED_AUTHOR_PASSWORD=Author@2026
SEED_ADMIN_PASSWORD=Admin@2026
