{
  "name": "@bookleaf/api",
  "version": "1.0.0",
  "private": true,
  "description": "BookLeaf support portal REST API (Express + MongoDB + AI SDK).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "seed": "tsx src/database/seed/run-seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.80",
    "@ai-sdk/openai": "4.0.94",
    "@bookleaf/contracts": "workspace:*",
    "@bookleaf/utils": "workspace:*",
    "ai": "7.0.141",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bookleaf/config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
